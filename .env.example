# ---------------------------------------------------------------- site
# Canonical origin. Used for canonical URLs, OG tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://pyris.tech

# ---------------------------------------------------------------- chains
# Pyris Pact is dual chain: Arc (5042, native USDC) and Robinhood Chain (4663, USDG ERC-20).
# Registry: src/lib/chains.ts. A network is offered when it has a PyrisPact address in
# contracts/deployments/<chainId>.json (synced by `npm run abi:sync`).
#
# Narrow or order the offered networks. Empty = every deployed mainnet chain (Arc, Robinhood).
# Local development with Anvil: NEXT_PUBLIC_CHAINS=31337
NEXT_PUBLIC_CHAINS=
# Preselected network. Empty = first offered chain (Arc).
NEXT_PUBLIC_DEFAULT_CHAIN_ID=5042

# Browser RPC / explorer overrides per chain. Unset = public RPC (Arc) or the same-origin
# relay /api/rpc/4663 (Robinhood Chain, whose public RPC is ISP-filtered in Indonesia).
NEXT_PUBLIC_RPC_URL_5042=
NEXT_PUBLIC_RPC_URL_4663=
NEXT_PUBLIC_RPC_URL_31337=
NEXT_PUBLIC_EXPLORER_URL_5042=
NEXT_PUBLIC_EXPLORER_URL_4663=

# Relay limits (requests/second per IP, burst).
RPC_RELAY_RATE=20
RPC_RELAY_BURST=60

# ---------------------------------------------------------------- social
# Official X account. Defaults to https://x.com/pyristech when unset.
NEXT_PUBLIC_X_URL=https://x.com/pyristech

# ---------------------------------------------------------------- deploy only
# Anvil account #0 is the default in `npm run deploy:local`.
# `npm run deploy:robinhood` needs a key holding a little ETH on Robinhood Chain (~0.0002 ETH).
# Never commit a funded mainnet key.
# PRIVATE_KEY=
# Escrow token on Robinhood Chain. Default USDG 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168 (6 decimals).
# USDC_ADDRESS_ROBINHOOD=
# Robinhood RPC override for the deploy script (the script starts its own forwarder when the
# public endpoint is filtered).
# ROBINHOOD_RPC_URL=
