# ---------------------------------------------------------------- site
# Canonical origin. Used for canonical URLs, OG tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://pillar.finance

# ---------------------------------------------------------------- chain
# Chain the frontend reads from. 31337 = local Anvil.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_NAME=Anvil

# Robinhood Chain (fill in when the public RPC and chain id are published):
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain

# ---------------------------------------------------------------- social
# Left blank until the accounts exist; the footer omits any link that is unset.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ---------------------------------------------------------------- deploy only
# Anvil account #0 is the default in `npm run deploy:local`.
# Never put a funded mainnet key in this file.
# PRIVATE_KEY=
