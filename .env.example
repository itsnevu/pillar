# ---------------------------------------------------------------- site
# Canonical origin. Used for canonical URLs, OG tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://pyris.tech

# ---------------------------------------------------------------- chain
# Chain the frontend reads from. 31337 = local Anvil.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_NAME=Anvil

# Block explorer origin. When set, contract addresses in the app link to it;
# when unset they render as plain text. Anvil has no explorer.
NEXT_PUBLIC_EXPLORER_URL=

# Arc Mainnet:
# NEXT_PUBLIC_CHAIN_ID=5042
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io
# NEXT_PUBLIC_CHAIN_NAME=Arc Mainnet

# ---------------------------------------------------------------- social
# Left blank until the accounts exist; the footer omits any link that is unset.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ---------------------------------------------------------------- deploy only
# Anvil account #0 is the default in `npm run deploy:local`.
# Never put a funded mainnet key in this file.
# PRIVATE_KEY=
